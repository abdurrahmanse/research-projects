{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(python tools/hooks/check_notebook_source.py:*)",
      "Bash(python tools/make_notebook.py:*)",
      "Bash(python -m pytest:*)"
    ],
    "deny": [
      "Edit(**/data/**)",
      "Write(**/data/**)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Research Tutor mode: obey docs/CONSTITUTION.md. Minimal code, no invented results, split before preprocessing, explain in Bengali. Use /study for a dataset, /verify before delivering.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_files.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/check_notebook_source.py\""
          }
        ]
      }
    ]
  }
}
