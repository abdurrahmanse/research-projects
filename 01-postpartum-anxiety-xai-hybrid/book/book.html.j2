    {% for c in [0,1,2,0,3,1,0,4,2,1,3,0,2,4,1] %}<circle cx="{{ 26 + loop.index0 * 33 }}" cy="62" r="10" fill="{{ colours[c] }}"/>{% endfor %}
    {% for c in [0,1,2,3,0,1] %}<circle cx="{{ 566 + loop.index0 * 33 }}" cy="62" r="10" fill="{{ colours[c] }}"/>{% endfor %}
